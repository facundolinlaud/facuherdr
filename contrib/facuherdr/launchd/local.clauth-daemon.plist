<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Keeps clauth's scheduler running: it refreshes usage and re-stamps the
       rolling session tokens that clauth-started Claude sessions use. -->
  <key>Label</key>
  <string>local.clauth-daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.cargo/bin/clauth</string>
    <string>daemon</string>
    <string>--standby</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:__HOME__/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/.clauth/daemon.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.clauth/daemon.err.log</string>
</dict>
</plist>
