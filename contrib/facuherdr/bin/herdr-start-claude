#!/usr/bin/env bash
# Starts Claude Code in a Herdr pane under a clauth account, and names the agent.
#
# Usage:
#   herdr-start-claude <pane-id> <name> [--account <profile>] [--feature <name>] [--timeout <seconds>] [-- <claude args>...]
#
# The account is --account, else the caller's own clauth account (`clauth which`).
# --feature files the agent under that feature group, creating it if needed;
# without it the agent keeps whatever feature its pane already has.
# The agent gets its own clauth login, so switching clauth's active account later
# does not move it. Everything after `--` goes to claude, e.g. `-- --model opus`.
# Prints a JSON summary on success; exits non-zero naming the failed step.
set -euo pipefail

usage="usage: herdr-start-claude <pane-id> <name> [--account <profile>] [--feature <name>] [--timeout <seconds>] [-- <claude args>...]"
herdr_bin="${HERDR_BIN_PATH:-herdr}"

fail() {
  printf 'herdr-start-claude: %s\n' "$1" >&2
  exit 1
}

[ "$#" -ge 2 ] || fail "$usage"
pane=$1
name=$2
shift 2
account=""
feature=""
timeout=60
while [ "$#" -gt 0 ]; do
  case $1 in
    --account) account=${2:?"--account needs a profile"}; shift 2 ;;
    --feature) feature=${2:?"--feature needs a name"}; shift 2 ;;
    --timeout) timeout=${2:?"--timeout needs seconds"}; shift 2 ;;
    --) shift; break ;;
    *) fail "unknown option: $1 ($usage)" ;;
  esac
done

command -v clauth >/dev/null 2>&1 || fail "clauth is not installed"
if [ -z "$account" ]; then
  account=$(clauth which 2>/dev/null || true)
  if [ -z "$account" ] || [ "$account" = "unknown" ]; then
    fail "cannot tell which clauth account to use; pass --account"
  fi
fi

# The line typed into the pane's shell, every word quoted.
command_line=$(printf '%q ' clauth start "$account" "$@")
"$herdr_bin" pane run "$pane" "$command_line" >/dev/null ||
  fail "could not type the start command into pane $pane"

# Herdr names only agents it has detected, so wait for Claude to show up.
deadline=$((SECONDS + timeout))
until [ "$("$herdr_bin" pane get "$pane" 2>/dev/null | jq -r '.result.pane.agent // empty')" = "claude" ]; do
  [ "$SECONDS" -lt "$deadline" ] || fail "Claude did not start in pane $pane within ${timeout}s"
  sleep 1
done

"$herdr_bin" agent rename "$pane" "$name" >/dev/null ||
  fail "Claude started in pane $pane, but naming it '$name' failed (names are lowercase letters, digits, - or _, and must be unique)"

if [ -n "$feature" ]; then
  "$herdr_bin" feature join "$feature" --create --pane "$pane" >/dev/null ||
    fail "Claude started in pane $pane as '$name', but filing it under feature '$feature' failed; do not start it again"
fi

jq -n --arg pane "$pane" --arg name "$name" --arg account "$account" --arg feature "$feature" --arg command "$command_line" \
  '{pane: $pane, name: $name, account: $account, feature: (if $feature == "" then null else $feature end), command: $command}'
